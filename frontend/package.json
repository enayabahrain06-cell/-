    "react-dom": "^18.3.1",
    "react-hook-form": "^7.89.0",
    "react-i18next": "^17.0.15",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
