APP_NAME="Ahl Al-Quran"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA
APP_TIMEZONE=UTC
APP_DISPLAY_TIMEZONE=Asia/Bahrain

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# =============================================================================
# DATABASE — pick ONE block. Nothing else in the code changes.
# =============================================================================

# --- SQLite (local development / tests) --------------------------------------
DB_CONNECTION=sqlite
# DB_DATABASE=C:/path/to/backend/database/database.sqlite   # optional, defaults to database/database.sqlite
DB_FOREIGN_KEYS=true
DB_SQLITE_JOURNAL_MODE=wal
DB_SQLITE_BUSY_TIMEOUT=5000

# --- MySQL 8 (production default) --------------------------------------------
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=ahl_alquran
# DB_USERNAME=ahl
# DB_PASSWORD=secret
# DB_CHARSET=utf8mb4
# DB_COLLATION=utf8mb4_unicode_ci

# --- PostgreSQL 15+ ----------------------------------------------------------
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=ahl_alquran
# DB_USERNAME=ahl
# DB_PASSWORD=secret
# DB_SCHEMA=public

# --- Target for `php artisan db:transfer` (copy SQLite -> MySQL/PostgreSQL) ----
# TRANSFER_DB_CONNECTION=mysql
# TRANSFER_DB_HOST=127.0.0.1
# TRANSFER_DB_PORT=3306
# TRANSFER_DB_DATABASE=ahl_alquran
# TRANSFER_DB_USERNAME=ahl
# TRANSFER_DB_PASSWORD=secret

# --- Backups (db:backup / db:restore) ----------------------------------------
BACKUP_PATH=storage/app/backups
# MYSQLDUMP_PATH=mysqldump
# MYSQL_PATH=mysql
# PG_DUMP_PATH=pg_dump
# PSQL_PATH=psql

# =============================================================================
# SESSION / CACHE / QUEUE — database by default; switch to redis if available
# =============================================================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
# CACHE_STORE=redis
# QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# =============================================================================
# FILES — local by default; S3-compatible (MinIO / AWS / DO Spaces) selectable
# =============================================================================
MEDIA_DISK=local
# MEDIA_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=me-south-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# =============================================================================
# WHATSAPP — provider: log | openwa | cloud
# =============================================================================
WHATSAPP_PROVIDER=log
# open-wa service (docker service "whatsapp" or local node process)
OPENWA_BASE_URL=http://localhost:8085
OPENWA_API_KEY=change-me
# Official WhatsApp Cloud API
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_API_VERSION=v20.0
# Delay between outgoing messages (seconds, random inside the range)
WHATSAPP_DELAY_MIN=3
WHATSAPP_DELAY_MAX=5
WHATSAPP_MAX_TRIES=3

# =============================================================================
# AUTH
# =============================================================================
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=3
OTP_LENGTH=6

# =============================================================================
# LOCALE DEFAULTS
# =============================================================================
DEFAULT_COUNTRY_CODE=973
DEFAULT_CURRENCY=BHD

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@ahlalquran.bh"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
