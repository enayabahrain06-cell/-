# Ahl Al-Quran System — production settings for docker compose (copy to .env next to docker-compose.yml).
# Generate the key once:  docker compose run --rm app php artisan key:generate --show   and paste it below.

APP_NAME="Ahl Al-Quran"
APP_KEY=
APP_URL=https://quran.example.bh
FRONTEND_URL=https://quran.example.bh
APP_LOCALE=ar
APP_TIMEZONE=UTC
APP_DISPLAY_TIMEZONE=Asia/Bahrain
HTTP_PORT=80
TRUSTED_PROXIES=*
SANCTUM_STATEFUL_DOMAINS=quran.example.bh
SESSION_SECURE_COOKIE=true

# --- database: pick ONE block and start compose with the matching profile ---------------------
# MySQL 8   (docker compose --profile mysql up -d)
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=ahl_alquran
DB_USERNAME=ahl
DB_PASSWORD=change-this-strong-password
DB_ROOT_PASSWORD=change-this-root-password

# PostgreSQL 15   (docker compose --profile pgsql up -d)
# DB_CONNECTION=pgsql
# DB_HOST=pgsql
# DB_PORT=5432
# DB_DATABASE=ahl_alquran
# DB_USERNAME=ahl
# DB_PASSWORD=change-this-strong-password

# SQLite (small centres; no database container)
# DB_CONNECTION=sqlite
# DB_DATABASE=/var/www/html/storage/database.sqlite

QUEUE_CONNECTION=database
CACHE_STORE=database
SESSION_DRIVER=database

# --- WhatsApp ---------------------------------------------------------------------------------
# log (nothing is sent) | openwa (the bundled bridge, --profile whatsapp) | cloud (Meta Cloud API)
WHATSAPP_PROVIDER=openwa
OPENWA_BASE_URL=http://whatsapp:8085
OPENWA_API_KEY=change-this-long-random-key
WHATSAPP_INBOUND_SECRET=change-this-long-random-secret
# WHATSAPP_CLOUD_TOKEN=
# WHATSAPP_CLOUD_PHONE_NUMBER_ID=
# WHATSAPP_CLOUD_APP_SECRET=

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@ahlalquran.bh"
